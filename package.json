{
  "name": "ensage",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:pm2": "pm2 start ecosystem.config.cjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx lib/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "cli": "tsx cli/index.ts",
    "cleanup": "node scripts/cleanup.mjs",
    "api-key:create": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/create-api-key.mjs",
    "test": "vitest run",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "bin": {
    "ensage": "./cli/ensage.mjs"
  },
  "engines": {
    "node": ">=26",
    "npm": ">=11"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@clerk/nextjs": "^7.5.17",
    "@clerk/ui": "^1.25.2",
    "@remixicon/react": "^4.9.0",
    "@shadcn/react": "^0.2.1",
    "argon2": "^0.44.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "file-type": "^22.0.1",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.24.0",
    "marked": "^18.0.6",
    "nanoid": "^6.0.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-resizable-panels": "^4.12.1",
    "recharts": "^3.8.0",
    "sanitize-html": "^2.17.6",
    "server-only": "^0.0.1",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
